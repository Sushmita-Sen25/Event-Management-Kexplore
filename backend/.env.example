NODE_ENV=development
PORT=5000
# MongoDB Atlas connection string
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/eventsphere?retryWrites=true&w=majority
# Long random string used to sign the session cookie
SESSION_SECRET=change-me
# Google OAuth 2.0 Web client ID (same one the frontend uses)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Comma-separated origins allowed to call the API directly
ALLOWED_ORIGINS=http://localhost:5173
